# Copiar este archivo a ".env" (sin ".example") y completar los valores reales.
# .env NUNCA se sube a git (ya está en .gitignore).

# Cadena de conexión a la base de datos Postgres (Supabase). La sacás de
# tu proyecto de Supabase: Project Settings -> Database -> Connection
# string -> modo "Session" (o "Transaction" si usás el pooler). Va a
# verse algo así:
# postgresql://postgres.xxxxxxxx:TU-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Secreto para firmar los tokens de sesión (JWT). Poné cualquier cadena
# larga y aleatoria — por ejemplo, generála con: openssl rand -hex 32
JWT_SECRET=cambiar-este-secreto-en-produccion

# Puerto donde escucha el servidor (opcional, por defecto 4000)
PORT=4000

# ── RingCentral (opcional) ──
# Si se dejan vacías, los recordatorios funcionan en modo simulado (quedan
# registrados en la consola y en Auditoría, pero no se manda ningún SMS
# real). Completá estas 4 variables cuando quieras conectar tu cuenta real:
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT=
RC_NUMERO_DESDE=
# Server de RingCentral (dejar el de producción salvo que uses un sandbox)
RC_SERVER_URL=https://platform.ringcentral.com

# ── Email (opcional) ──
# Para poder mandar la factura en PDF por mail. Si se dejan vacías, el
# envío queda simulado (no manda nada real, pero no rompe nada). Sirve
# con Gmail (necesitás una "contraseña de aplicación", no la contraseña
# normal — se genera en myaccount.google.com/apppasswords), con un
# dominio propio, o con SendGrid/Resend/Mailgun en modo SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Outlook / Microsoft 365 (pestaña "Pagos ingresados por mail") ──
# Ver OUTLOOK.md. Si se dejan vacías, la pestaña avisa que falta configurar.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=
# Carpeta donde caen los mails de Zelle (Inbox por defecto)
MS_CARPETA=Inbox
# Poné "grupo" si MS_MAILBOX es un grupo de Microsoft 365 (se detecta solo, es opcional)
MS_TIPO=

# Cada cuántos segundos revisar el buzón en busca de pagos nuevos (0 = solo con el botón)
MS_POLL_SEGUNDOS=60

# Kotapay (pagos con tarjeta): llegan al Gmail como "Receipt for Vehicle Number: ..."
# Se lee por IMAP con una contraseña de aplicación (Cuenta de Google > Seguridad > Contraseñas de aplicaciones)
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_CARPETA=INBOX
